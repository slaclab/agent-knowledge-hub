# Copy to .env and fill in values for local development
MONGO_URI=mongodb://localhost:27017/agent-skills
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
AUTH_MODE=dev
DEV_USER=your-slac-username
ADMIN_USERS=your-slac-username

# GitHub App credentials (optional — enables auto-fetch for private slaclab repos)
# Create a GitHub App in the slaclab org with read-only Contents + Metadata permissions.
# See docs/runbooks/github-app-setup.md for setup instructions.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Comma-separated GitHub orgs treated as private (skip unauthenticated fallback)
GITHUB_PRIVATE_ORGS=slaclab

# Shared secret for Next.js → backend trust (optional; disables proxy auth path when unset)
# Generate with: openssl rand -hex 32
# Store in Vault: vault kv put secret/tid/agent-knowledge-hub-<env>/app INTERNAL_API_SECRET=<value>
INTERNAL_API_SECRET=

# JWT Bearer auth (Path 3) — CLI tools with SLAC-issued tokens from ~/.s3df-access-token
# Keys are fetched automatically from JWT_JWKS_URI at runtime; no secret to manage.
# Override JWT_JWKS_URI / JWT_ISSUER to point at prod vs dev Dex when deploying.
JWT_JWKS_URI=https://dex-dev.slac.stanford.edu/keys
# RS256 is the only supported algorithm. Do not change unless SLAC Dex rotates to a new algorithm.
JWT_ALGORITHM=RS256
# Must match the iss claim in SLAC Dex tokens. Do not change unless the Dex endpoint moves.
JWT_ISSUER=https://dex-dev.slac.stanford.edu
# Must match the aud claim in SLAC Dex tokens issued for this application.
JWT_AUDIENCE=s3df
